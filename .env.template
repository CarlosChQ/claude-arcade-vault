# Copia este fichero a .env.local y rellena los valores reales.
# Solo se leen en el servidor: nunca uses el prefijo NEXT_PUBLIC_.

# API key de Resend (https://resend.com/api-keys). Obligatoria.
RESEND_API_KEY=

# Destinatario de los mensajes del formulario de contacto. Obligatoria.
# Con el remitente onboarding@resend.dev, Resend solo entrega al correo de la
# cuenta de Resend; para otro destinatario hace falta un dominio verificado.
CONTACT_TO_EMAIL=

# Remitente, p. ej. "Arcade Vault <contacto@arcadevault.gg>". Opcional.
# Si falta: Arcade Vault <onboarding@resend.dev>
CONTACT_FROM_EMAIL=
