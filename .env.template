# Copia este fichero a .env.local y rellena los valores reales.

# --- Contacto (Resend) ---
# Solo se leen en el servidor: nunca uses el prefijo NEXT_PUBLIC_.

# API key de Resend (https://resend.com/api-keys). Obligatoria.
RESEND_API_KEY=

# Destinatario de los mensajes del formulario de contacto. Obligatoria.
# Con el remitente onboarding@resend.dev, Resend solo entrega al correo de la
# cuenta de Resend; para otro destinatario hace falta un dominio verificado.
CONTACT_TO_EMAIL=

# Remitente, p. ej. "Arcade Vault <contacto@arcadevault.gg>". Opcional.
# Si falta: Arcade Vault <onboarding@resend.dev>
CONTACT_FROM_EMAIL=

# --- Supabase ---
# Públicas por diseño (prefijo NEXT_PUBLIC_): las usan los clientes de servidor
# y de navegador. La seguridad de los datos depende de RLS, no de ocultarlas.
# Se insertan en el bundle del navegador durante la build: si cambian en
# producción, hay que reconstruir la app.
# Valores: herramientas MCP get_project_url y get_publishable_keys, o el
# dashboard de Supabase (Project Settings → API Keys).

# URL del proyecto, p. ej. https://<project_ref>.supabase.co. Obligatoria.
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_…), no la anon key legacy. Obligatoria.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
